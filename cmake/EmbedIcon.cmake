# Turns the window icon PNG into a C array. Run as: cmake -DOUT=<file.cpp> -DPNG=<window128.png> -P EmbedIcon.cmake
file(READ "${PNG}" hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
file(WRITE "${OUT}" "// Generated by cmake/EmbedIcon.cmake. Do not edit.
#include \"platform/WindowIcon.h\"
namespace choco::platform {
extern const unsigned char kWindowIconPng[] = {${bytes}0};
extern const std::size_t kWindowIconPngSize = sizeof(kWindowIconPng) - 1;
}  // namespace choco::platform
")
