# Turns Lua files into C arrays. Run as: cmake -DOUT=<file.cpp> -DPRELUDE=<prelude.lua> -DHOST=<host.lua> -DANIMSCRIPT=<animationscript.lua> -P EmbedLua.cmake
function(embed_one var file)
  file(READ "${file}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  set(${var} "${bytes}" PARENT_SCOPE)
endfunction()

embed_one(prelude_bytes "${PRELUDE}")
embed_one(host_bytes "${HOST}")
embed_one(anim_bytes "${ANIMSCRIPT}")
file(WRITE "${OUT}" "// Generated by cmake/EmbedLua.cmake. Do not edit.
#include \"script/Embedded.h\"
namespace choco::script {
extern const unsigned char kEmbeddedPrelude[] = {${prelude_bytes}0};
extern const std::size_t kEmbeddedPreludeSize = sizeof(kEmbeddedPrelude) - 1;
extern const unsigned char kEmbeddedHost[] = {${host_bytes}0};
extern const std::size_t kEmbeddedHostSize = sizeof(kEmbeddedHost) - 1;
extern const unsigned char kEmbeddedAnimationScript[] = {${anim_bytes}0};
extern const std::size_t kEmbeddedAnimationScriptSize = sizeof(kEmbeddedAnimationScript) - 1;
}  // namespace choco::script
")
